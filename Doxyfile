PROJECT_NAME           = "nmea-gps-logger"
PROJECT_BRIEF          = "NMEA 0183 parser, track logger and geofence monitor in C++17"
PROJECT_NUMBER         = 1.0.0
OUTPUT_DIRECTORY       = build/docs
INPUT                  = include/nmea docs/api.md
FILE_PATTERNS          = *.hpp *.md
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = docs/api.md
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES
STRIP_FROM_PATH        = include
STRIP_FROM_INC_PATH    = include
FULL_PATH_NAMES        = YES
ENABLE_PREPROCESSING   = YES
HAVE_DOT               = NO
